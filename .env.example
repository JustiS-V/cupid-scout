# ==========================================
# MEDIA NODE VISION CONTRACT (LM Studio / Ollama)
# ==========================================
MEDIA_VISION_BACKEND=lmstudio
# Local Mac LM Studio or Worker via Tailscale:
MEDIA_VISION_URL=http://127.0.0.1:1234
# For Worker Node: MEDIA_VISION_URL=http://100.108.136.100:1234
MEDIA_VISION_MODEL=media-vision
MEDIA_VISION_TIMEOUT=120

# Cloud Fallback (Optional)
GEMINI_API_KEY=

# Telegram Userbot Credentials (if using ДайВинчик / Telethon)
# Get api_id & api_hash at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Telegram Alert Bot (where hot matches are delivered to your personal chat)
NOTIFICATION_BOT_TOKEN=
NOTIFICATION_CHAT_ID=

# Preferences
MIN_ATTRACTIVENESS_SCORE=7.0
MIN_INTENT_MATCH_SCORE=6.0
CHROME_DEBUG_PORT=9222
