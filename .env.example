# ==========================================
# ВЫБОР ПРОВАЙДЕРА НЕЙРОСЕТИ (LLM_PROVIDER)
# ==========================================
# Доступные варианты:
# - worker_lms : 12-ядерный воркер через SSH-туннель (БЕСПЛАТНО, ПО УМОЛЧАНИЮ)
# - local_lms  : LM Studio локально на Mac (lms server start)
# - gemini     : Google Gemini 2.5 Flash (быстро, копейки)
# - openai     : ChatGPT GPT-4o / GPT-4o-mini
# - ollama     : Локальный Ollama
LLM_PROVIDER=worker_lms

# 1. Параметры LM Studio (Воркер или локальный Mac)
MEDIA_VISION_BACKEND=lmstudio
MEDIA_VISION_URL=http://127.0.0.1:1234
MEDIA_VISION_MODEL=media-vision
MEDIA_VISION_TIMEOUT=120

# 2. Облачные провайдеры (если LLM_PROVIDER=gemini или openai)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 3. Telegram ДайВинчик (Userbot)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# 4. Telegram Alert Bot (для пушей на твой телефон о горячих мэтчах)
NOTIFICATION_BOT_TOKEN=
NOTIFICATION_CHAT_ID=

# 5. Пороги отбора
MIN_ATTRACTIVENESS_SCORE=7.0
MIN_INTENT_MATCH_SCORE=6.0
CHROME_DEBUG_PORT=9222
