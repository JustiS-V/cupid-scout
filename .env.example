# Local LM Studio (Default & Free - No API keys required!)
USE_LOCAL_LM_STUDIO=true
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen2.5-vl-7b-instruct

# Cloud Fallbacks (Optional)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Telegram Userbot Credentials (if using ДайВинчик / Telethon)
# Get api_id & api_hash at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Telegram Alert Bot (where hot matches are delivered to your personal chat)
NOTIFICATION_BOT_TOKEN=
NOTIFICATION_CHAT_ID=

# Preferences
MIN_ATTRACTIVENESS_SCORE=7.0
MIN_INTENT_MATCH_SCORE=6.0
CHROME_DEBUG_PORT=9222
